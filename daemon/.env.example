# HVM Daemon Environment Configuration
PORT=5090
DB_HOST=127.0.0.1
DB_PORT=7090
DB_USER=hvm_user
DB_PASSWORD=StrongHvmDbPassword123!
DB_NAME=hvm_panel

JWT_SECRET=change-this-super-secret-hvm-jwt-key-in-production
LIBVIRT_URI=qemu:///system
IMAGES_DIR=/var/lib/libvirt/images/hvm
TEMPLATES_DIR=/var/lib/libvirt/images/templates
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@hvm.local
DEFAULT_ADMIN_PASSWORD=admin
